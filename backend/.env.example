# Copy to .env (or export as real environment variables) before running the backend.
DB_URL=jdbc:postgresql://localhost:5433/examdb
DB_USERNAME=examuser
DB_PASSWORD=exampass

# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-in-production-min-32-bytes

JWT_ADMIN_ACCESS_MIN=30
JWT_ADMIN_REFRESH_DAYS=7
JWT_STUDENT_SESSION_MIN=240

CORS_ALLOWED_ORIGINS=http://localhost:5173
