# ==============================================================================
# Proxmox / Production Environment Configuration
# Copy this file to .env before running: docker compose up -d --build
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_DB=examdb
POSTGRES_USER=examuser
POSTGRES_PASSWORD=exampass

# JWT Secret (Must be at least 32 characters long in production)
JWT_SECRET=production-long-random-secret-key-for-jwt-signing-min-32-chars

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://your-proxmox-ip-or-domain
